# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Used when approving applications — Supabase admin creates the user account
# (Same as NEXT_PUBLIC_SUPABASE_URL above, kept separate for clarity)

# ─── Email — Resend ───────────────────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key

# The verified "From" address in Resend (e.g. hello@skillsync.pk)
RESEND_FROM=onboarding@resend.dev

# Admin inbox that receives new application notifications
ADMIN_EMAIL=admin@skillsync.pk

# Public contact email shown on the site
CONTACT_EMAIL=hello@skillsync.pk

# ─── Site ─────────────────────────────────────────────────────────────────────
# Full URL without trailing slash — used for OG tags, sitemap, robots.txt
NEXT_PUBLIC_SITE_URL=https://skillsync.pk
